{
  "name": "cosmos-proposal-builder",
  "version": "1.0.0",
  "private": true,
  "description": "Helps you build software upgrade proposals.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/compress.js && tsc -p tsconfig.server.json",
    "start": "node dist/node/server/index.js",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.server.json --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyphacoop/cosmos-proposal-builder.git"
  },
  "bugs": {
    "url": "https://github.com/hyphacoop/cosmos-proposal-builder/issues"
  },
  "homepage": "https://github.com/hyphacoop/cosmos-proposal-builder#readme",
  "dependencies": {
    "@fastify/static": "^10.1.6",
    "fastify": "^5.12.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
